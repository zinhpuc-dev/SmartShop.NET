@attribute [Authorize(Policy = AdminLoginService.Policy)]
@page "/admin"
@layout SmartShop.Admin.Components.Layout.AdminLayout
@inherits ShopPageBase
@inject ProductManageService ProductService
@inject OrderManagementService OrderService
@inject InvoiceManagementService InvoiceService
@inject IEmployeeService EmployeeService
@inject IJSRuntime JavaScript
@inject ILogger<Admin> Logger
<PageTitle>@PageName — SmartShop</PageTitle>
<div class="section-heading">
    <div>
        <div class="eyebrow red">SMARTSHOP / ADMIN</div>
        <h1>Tổng quan cửa hàng</h1>
        <p class="subtitle">Một góc nhìn, mọi hoạt động.</p>
    </div>
    <span class="status">● Tổng quan cửa hàng</span>
</div>
<div class="metrics">
    <div class="panel"><span>Doanh thu 30 ngày</span><h2>@(reportLoaded ? MoneyFormatter.Format(summary!.Revenue) : "—")</h2><small class="green">Chỉ tính hóa đơn đã thanh toán</small>@if (!reportLoaded && !reportLoading) { <small>@reportError <button type="button" @onclick="LoadReportData">Thử lại</button></small> }</div>
    <div class="panel"><span>Đơn hàng</span><h2>@(ordersLoaded ? orders.Count : "—")</h2><small>Đơn hàng trong hệ thống</small>@if (!ordersLoaded && !ordersLoading) { <small>@ordersError <button type="button" @onclick="LoadOrderData">Thử lại</button></small> }</div>
    <div class="panel"><span>Sản phẩm</span><h2>@(productsLoaded ? products.Count : "—")</h2><small>Danh mục sản phẩm</small>@if (!productsLoaded && !productLoading) { <small>@productError <button type="button" @onclick="LoadProducts">Thử lại</button></small> }</div>
    <div class="panel"><span>Tồn kho</span><h2>@(productsLoaded ? products.Sum(p => p.TongSoLuongTon) : "—")</h2><small>Tổng số lượng trong các kho</small>@if (!productsLoaded && !productLoading) { <small>Chưa thể tải số lượng tồn kho.</small> }</div>
</div>
<ChoiceTabs Items="AdminTabs" @bind-Value="adminTab" CssClass="admin-tabs" />
<section class="panel">
    @if (!string.IsNullOrEmpty(successMessage)) { <p class="customer-feedback" role="status">@successMessage</p> }
    @if (adminTab == "Sản phẩm")
    {
        <div class="section-heading"><h2>Quản lý sản phẩm</h2><span class="muted">Sản phẩm và tồn kho theo kho</span></div>
        @if (!string.IsNullOrEmpty(productActionError)) { <div class="customer-feedback error" role="alert">@productActionError</div> }
        <div class="form-grid">
            <label>Mã loại<input @bind="categoryDraft.MaLoai" maxlength="6" disabled="@categoryEditing" /></label>
            <label>Trạng thái loại<select @bind="categoryDraft.TrangThai"><option value="true">Đang hoạt động</option><option value="false">Ngừng hoạt động</option></select></label>
            <button type="button" @onclick="SaveCategory" disabled="@(!productLoaded)">@(categoryEditing ? "Cập nhật loại" : "Thêm loại")</button>
        </div>
        @if (productLoading) { <p role="status">Đang tải sản phẩm...</p> }
        else if (!productLoaded) { <div class="customer-feedback error" role="alert">@productError <button type="button" @onclick="LoadProducts">Thử lại</button></div> }
        else
        {
        <DataTable TItem="ProductCategory" Items="productCategories" Label="Danh sách loại sản phẩm" ColumnCount="3" EmptyText="Chưa có loại sản phẩm.">
            <Header><th scope="col">Mã loại</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></Header>
            <RowTemplate Context="category">
                <td>@category.MaLoai</td><td>@(category.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")</td>
                <td><button type="button" @onclick="() => EditCategory(category)">Sửa</button><button type="button" @onclick="() => DeactivateCategory(category)">Ngừng</button></td>
            </RowTemplate>
        </DataTable>
        <div class="form-grid">
            <label>Mã sản phẩm<input @bind="productDraft.MaSP" maxlength="8" disabled="@productEditing" /></label>
            <label>Loại sản phẩm<select @bind="productDraft.MaLoai"><option value="">Chọn loại</option>@foreach (var category in productCategories.Where(c => c.TrangThai || c.MaLoai == productDraft.MaLoai)){<option value="@category.MaLoai">@category.MaLoai</option>}</select></label>
            <label>Tên sản phẩm<input @bind="productDraft.TenSP" maxlength="200" /></label>
            <label>Đơn vị tính<input @bind="productDraft.DonViTinh" maxlength="30" /></label>
            <label>Giá niêm yết<input type="number" min="0" step="0.01" @bind="productDraft.GiaNiemYet" /></label>
            <label>Giá bán<input type="number" min="0" step="0.01" @bind="productDraft.GiaBan" /></label>
            <label>Trạng thái<select @bind="productDraft.TrangThai"><option value="1">Đang bán</option><option value="0">Ngừng bán</option></select></label>
            <label>Mô tả<textarea @bind="productDraft.MoTa" maxlength="65535"></textarea></label>
            <button type="button" @onclick="SaveManagedProduct" disabled="@(!productLoaded)">@(productEditing ? "Cập nhật sản phẩm" : "Thêm sản phẩm")</button>
            @if (productEditing){<button type="button" @onclick="ResetProduct">Hủy</button>}
        </div>
        <label>Tìm sản phẩm<input placeholder="Mã hoặc tên sản phẩm" @bind="productSearch" @bind:event="oninput" /></label>
        <DataTable TItem="ProductManage" Items="FilteredProducts" Label="Danh sách sản phẩm" ColumnCount="7" EmptyText="Chưa có sản phẩm.">
            <Header>
                <th scope="col">Sản phẩm</th><th scope="col">Mã danh mục</th><th scope="col">Giá bán</th><th scope="col">Giá niêm yết</th><th scope="col">Tồn</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th>
            </Header>
            <RowTemplate Context="product">
                <td><strong>@product.TenSP</strong><small>@product.MaSP</small></td>
                <td>@product.MaLoai</td>
                <td>@MoneyFormatter.Format(product.GiaBan)</td>
                <td>@MoneyFormatter.Format(product.GiaNiemYet)</td>
                <td>@product.TongSoLuongTon</td>
                <td><span class="status @(product.TrangThai == "1" ? "" : "warning")">@(product.TrangThai == "1" ? "Đang bán" : "Ngừng bán")</span></td>
                <td><button type="button" @onclick="() => EditProduct(product)">Sửa</button><button type="button" @onclick="() => ShowStock(product)">Tồn kho</button><button type="button" @onclick="() => DeactivateProduct(product)">Ngừng</button></td>
            </RowTemplate>
        </DataTable>
        @if (selectedProduct is not null)
        {
            <h3>Tồn kho @selectedProduct.TenSP</h3>
            @if (stockLoading) { <p role="status">Đang tải tồn kho...</p> }
            else if (!stockLoaded) { <div class="customer-feedback error" role="alert">@stockError <button type="button" @onclick="() => ShowStock(selectedProduct)">Thử lại</button></div> }
            else { <DataTable TItem="ProductStock" Items="selectedStock" Label="Tồn kho theo kho" ColumnCount="3" EmptyText="Chưa có dữ liệu tồn kho.">
                <Header><th scope="col">Mã kho</th><th scope="col">Kho</th><th scope="col">Số lượng</th></Header>
                <RowTemplate Context="stock"><td>@stock.MaKho</td><td>@stock.TenKho</td><td>@stock.SoLuongTon</td></RowTemplate>
            </DataTable> }
        }
        }
    }
    else if (adminTab == "Đơn hàng")
    {
        <h2>Quản lý đơn hàng</h2>
        <div class="form-grid">
            <label>Tìm đơn hàng<input placeholder="Mã đơn, khách hàng" @bind="orderSearch" @bind:event="oninput" /></label>
            <label>Trạng thái<select @bind="orderFilter"><option value="">Tất cả</option><option>Đang xử lý</option><option>Đã xác nhận</option><option>Đang giao hàng</option><option>Đã giao</option><option>Hoàn thành</option><option>Đã hủy</option></select></label>
            <button type="button" @onclick="LoadOrderData">Tải lại</button>
        </div>
        @if (ordersLoading) { <p role="status">Đang tải đơn hàng...</p> }
        else if (!ordersLoaded) { <div class="customer-feedback error" role="alert">@ordersError <button type="button" @onclick="LoadOrderData">Thử lại</button></div> }
        else
        {
        @if (!string.IsNullOrEmpty(warehouseError)) { <div class="customer-feedback error" role="alert">@warehouseError <button type="button" @onclick="LoadOrderData">Thử lại</button></div> }
        @if (!string.IsNullOrEmpty(orderActionError)) { <div class="customer-feedback error" role="alert">@orderActionError</div> }
        <DataTable TItem="ManagedOrder" Items="FilteredOrders" Label="Danh sách đơn hàng" ColumnCount="7" EmptyText="Chưa có đơn hàng.">
            <Header><th scope="col">Đơn hàng / khách hàng</th><th scope="col">Ngày tạo</th><th scope="col">Chi tiết</th><th scope="col">Kho xuất</th><th scope="col">Tổng tiền</th><th scope="col">Trạng thái</th><th scope="col">Lưu</th></Header>
            <RowTemplate Context="order">
                <td><strong>@order.Code</strong><small>@order.CustomerName (@order.CustomerCode)</small><small>@order.Address</small></td>
                <td>@order.Created.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@foreach (var line in order.Lines){<small>@line.ProductName × @line.Quantity — @MoneyFormatter.Format(line.LineTotal)</small>}</td>
                <td><select aria-label="Kho xuất @order.Code" @bind="warehouseSelection[order.Code]"><option value="">Chọn kho</option>@foreach(var warehouse in warehouses){<option value="@warehouse.Code">@warehouse.Code — @warehouse.Name</option>}</select></td>
                <td>@MoneyFormatter.Format(order.Total)</td>
                <td><select aria-label="Trạng thái @order.Code" @bind="statusSelection[order.Code]"><option>Đang xử lý</option><option>Đã xác nhận</option><option>Đang giao hàng</option><option>Đã giao</option><option>Hoàn thành</option><option>Đã hủy</option></select></td>
                <td><button type="button" @onclick="() => SaveOrderStatus(order.Code)" disabled="@(!string.IsNullOrEmpty(warehouseError))">Lưu</button></td>
            </RowTemplate>
        </DataTable>
        }
    }
    else
    {
        <h2>Báo cáo doanh thu và hóa đơn</h2>
        <h3>Lập hóa đơn</h3>
        <div class="form-grid">
            <label>Đơn đã giao<select @bind="invoiceOrder"><option value="">Chọn đơn hàng</option>
                @foreach (var order in orders.Where(o => o.InvoiceCode is null && (o.Status == "Đã giao" || o.Status == "Hoàn thành")))
                { <option value="@order.Code">@order.Code — @order.CustomerName</option> }
            </select></label>
            <label>Nhân viên<select @bind="invoiceEmployee"><option value="">Chọn nhân viên</option>
                @foreach (var employee in invoiceEmployees) { <option value="@employee.Code">@employee.Code — @employee.Name</option> }
            </select></label>
            <label>Thanh toán<select @bind="invoiceMethod"><option>Tiền mặt</option><option>Chuyển khoản</option><option>COD</option></select></label>
            <button type="button" @onclick="CreateInvoice" disabled="@(!ordersLoaded || !invoiceEmployeesLoaded)">Lập hóa đơn</button>
        </div>
        @if (!invoiceEmployeesLoaded) { <p class="customer-feedback error">Chưa tải được nhân viên lập hóa đơn. <button @onclick="LoadInvoiceEmployees">Thử lại</button></p> }
        @if (!string.IsNullOrEmpty(invoiceActionError)) { <p class="customer-feedback error" role="alert">@invoiceActionError</p> }
        <div class="form-grid">
            <label>Từ ngày<input type="date" @bind="reportFrom" /></label>
            <label>Đến ngày<input type="date" @bind="reportTo" /></label>
            <button type="button" @onclick="LoadReportData">Xem báo cáo</button>
        </div>
        @if (reportLoaded) { <p>@summary!.From.ToString("yyyy-MM-dd") — @summary.To.ToString("yyyy-MM-dd") · @summary.OrderCount đơn có hóa đơn đã thanh toán · @summary.InvoiceCount hóa đơn đã thanh toán · @summary.ProductsSold sản phẩm bán</p> }
        else if (reportLoading) { <p role="status">Đang tải báo cáo...</p> }
        else { <div class="customer-feedback error" role="alert">@reportError <button type="button" @onclick="LoadReportData">Thử lại</button></div> }
        @if (reportLoaded) { <strong>Doanh thu: @MoneyFormatter.Format(summary!.Revenue)</strong> }
        @if (invoicesLoading) { <p role="status">Đang tải hóa đơn...</p> }
        else if (!invoicesLoaded) { <div class="customer-feedback error" role="alert">@invoiceError <button type="button" @onclick="LoadInvoiceData">Thử lại</button></div> }
        else
        {
        <DataTable TItem="ManagedInvoice" Items="invoices" Label="Hóa đơn" ColumnCount="7" EmptyText="Chưa có hóa đơn.">
            <Header><th scope="col">Hóa đơn</th><th scope="col">Đơn hàng</th><th scope="col">Nhân viên</th><th scope="col">Thời gian</th><th scope="col">Chi tiết</th><th scope="col">Tổng thanh toán</th><th scope="col">Thu tiền</th></Header>
            <RowTemplate Context="invoice"><td>@invoice.Code<small>@invoice.PaymentMethod · @invoice.Status</small></td><td>@invoice.OrderCode</td><td>@invoice.EmployeeName (@invoice.EmployeeCode)</td><td>@invoice.Created.ToString("yyyy-MM-dd HH:mm")</td><td>@foreach(var line in invoice.Lines){<small>@line.ProductName × @line.Quantity</small>}</td><td>@MoneyFormatter.Format(invoice.Total)</td><td>@if (invoice.Status == "Chờ thanh toán") { <button type="button" @onclick="() => MarkInvoicePaid(invoice)">Xác nhận đã thu tiền</button> }</td></RowTemplate>
        </DataTable>
        }
    }
</section>

@code {
    private static readonly string[] AdminTabs = ["Sản phẩm", "Đơn hàng", "Thống kê"];
    private List<ProductManage> products = [];
    private string productSearch = "", orderSearch = "", orderFilter = "";
    private IEnumerable<ProductManage> FilteredProducts => products.Where(p => string.IsNullOrWhiteSpace(productSearch)
        || p.MaSP.Contains(productSearch.Trim(), StringComparison.OrdinalIgnoreCase) || p.TenSP.Contains(productSearch.Trim(), StringComparison.OrdinalIgnoreCase));
    private IEnumerable<ManagedOrder> FilteredOrders => orders.Where(o => (string.IsNullOrEmpty(orderFilter) || o.Status == orderFilter)
        && (string.IsNullOrWhiteSpace(orderSearch) || o.Code.Contains(orderSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || o.CustomerName.Contains(orderSearch.Trim(), StringComparison.OrdinalIgnoreCase)));
    private List<ProductCategory> productCategories = [];
    private ProductManage productDraft = new() { TrangThai = "1" };
    private ProductCategory categoryDraft = new();
    private List<ProductStock> selectedStock = [];
    private ProductManage? selectedProduct;
    private bool stockLoading, stockLoaded;
    private string stockError = "Không thể tải tồn kho sản phẩm. Vui lòng thử lại.";
    private bool productEditing;
    private bool categoryEditing;
    private string productError = "Không thể tải danh sách sản phẩm. Vui lòng kiểm tra kết nối và thử lại.";
    private string productActionError = "";
    private string successMessage = "";
    private bool productLoading = true;
    private bool productLoaded;
    private bool productsLoaded;
    private List<ManagedOrder> orders = [];
    private IReadOnlyList<Warehouse> warehouses = [];
    private IReadOnlyList<ManagedInvoice> invoices = [];
    private Dictionary<string, string> statusSelection = [];
    private Dictionary<string, string> warehouseSelection = [];
    private IReadOnlyList<Employee> invoiceEmployees = [];
    private bool invoiceEmployeesLoaded;
    private string invoiceOrder = "", invoiceEmployee = "", invoiceMethod = "Tiền mặt", invoiceActionError = "";
    private SalesSummary? summary;
    private DateTime reportFrom = DateTime.Today.AddDays(-29), reportTo = DateTime.Today;
    private string ordersError = "Không thể tải danh sách đơn hàng. Vui lòng thử lại.";
    private string warehouseError = "";
    private string orderActionError = "";
    private string reportError = "Không thể tải báo cáo doanh thu. Vui lòng thử lại.";
    private string invoiceError = "Không thể tải danh sách hóa đơn. Vui lòng thử lại.";
    private bool ordersLoading = true;
    private bool ordersLoaded;
    private bool invoicesLoading = true;
    private bool invoicesLoaded;
    private bool reportLoaded;
    private bool reportLoading = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadProducts();
        LoadOrderData();
        LoadInvoiceData();
        LoadInvoiceEmployees();
        LoadReportData();
    }

    private void LoadProducts()
    {
        productLoading = true;
        productLoaded = false;
        try
        {
            products = ProductService.Read();
            productCategories = ProductService.ReadCategories();
            productLoaded = productsLoaded = true;
            productError = "";
            productActionError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin product catalog.");
            productLoaded = productsLoaded = false;
            productError = "Không thể tải danh sách sản phẩm. Vui lòng kiểm tra kết nối và thử lại.";
            products = [];
            productCategories = [];
        }
        finally { productLoading = false; }
    }

    private void LoadOrderData()
    {
        ordersLoading = true;
        ordersLoaded = false;
        orderActionError = "";
        ordersError = "Không thể tải danh sách đơn hàng. Vui lòng thử lại.";
        try
        {
            orders = OrderService.GetOrders().ToList();
            warehouseError = "";
            try { warehouses = OrderService.GetWarehouses(); }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load Admin warehouse options.");
                warehouses = [];
                warehouseError = "Không thể tải danh sách kho. Hãy thử tải lại trước khi cập nhật trạng thái đơn hàng.";
            }
            statusSelection = orders.ToDictionary(o => o.Code, o => o.Status);
            warehouseSelection = orders.ToDictionary(o => o.Code, o => o.WarehouseCode ?? "");
            ordersLoaded = true;
            ordersError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin orders.");
            orders = [];
            ordersError = "Không thể tải danh sách đơn hàng. Vui lòng thử lại.";
        }
        finally { ordersLoading = false; }
    }

    private void LoadInvoiceEmployees()
    {
        try { invoiceEmployees = EmployeeService.Search(); invoiceEmployeesLoaded = true; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load invoice employees."); invoiceEmployees = []; invoiceEmployeesLoaded = false; }
    }

    private void CreateInvoice()
    {
        invoiceActionError = "";
        try
        {
            InvoiceService.CreateInvoice(invoiceOrder, invoiceEmployee, invoiceMethod);
            invoiceOrder = "";
            LoadInvoiceData(); LoadOrderData(); LoadReportData();
            successMessage = "Đã lập hóa đơn chờ thanh toán.";
        }
        catch (ArgumentException ex) { invoiceActionError = ex.Message; }
        catch (InvalidOperationException ex) { invoiceActionError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to issue invoice."); invoiceActionError = "Không thể lập hóa đơn. Vui lòng thử lại."; }
    }

    private async Task MarkInvoicePaid(ManagedInvoice invoice)
    {
        if (!await JavaScript.InvokeAsync<bool>("confirm", $"Xác nhận đã thu đủ {MoneyFormatter.Format(invoice.Total)} cho hóa đơn {invoice.Code}?")) return;
        invoiceActionError = "";
        try
        {
            InvoiceService.MarkPaid(invoice.Code);
            LoadInvoiceData(); LoadReportData();
            successMessage = "Đã xác nhận thanh toán hóa đơn.";
        }
        catch (InvalidOperationException ex) { invoiceActionError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to mark invoice paid."); invoiceActionError = "Không thể xác nhận thanh toán. Vui lòng thử lại."; }
    }

    private void LoadInvoiceData()
    {
        invoicesLoading = true;
        invoicesLoaded = false;
        invoiceError = "Không thể tải danh sách hóa đơn. Vui lòng thử lại.";
        try
        {
            invoices = InvoiceService.GetInvoices();
            invoicesLoaded = true;
            invoiceError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin invoices.");
            invoices = [];
            invoiceError = "Không thể tải danh sách hóa đơn. Vui lòng thử lại.";
        }
        finally { invoicesLoading = false; }
    }

    private void LoadReportData()
    {
        reportLoading = true;
        reportLoaded = false;
        reportError = "Không thể tải báo cáo doanh thu. Vui lòng thử lại.";
        try
        {
            if (reportFrom.Date > reportTo.Date) throw new ArgumentException("Ngày bắt đầu không được sau ngày kết thúc.");
            summary = OrderService.GetSalesSummary(reportFrom.Date, reportTo.Date.AddDays(1));
            reportLoaded = true;
            reportError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin sales report.");
            summary = null;
            reportError = "Không thể tải báo cáo doanh thu. Vui lòng thử lại.";
        }
        finally { reportLoading = false; }
    }

    private void SaveOrderStatus(string code)
    {
        try
        {
            OrderService.UpdateStatus(code, statusSelection[code], warehouseSelection[code]);
            LoadOrderData();
            successMessage = "Đã cập nhật đơn hàng.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update order status for {OrderCode}.", code);
            orderActionError = ex.Message.Contains("migration", StringComparison.OrdinalIgnoreCase)
                ? "Chưa thể hoàn tất đơn hàng vì cần thiết lập phân bổ kho. Vui lòng liên hệ người quản lý để hoàn tất thiết lập."
                : ex is InvalidOperationException ? ex.Message : "Không thể cập nhật đơn hàng. Vui lòng kiểm tra thông tin và thử lại.";
        }
    }

    private void SaveManagedProduct()
    {
        try
        {
            if (productEditing) ProductService.UpDate(productDraft); else ProductService.Insert(productDraft);
            products = ProductService.Read();
            productError = "";
            productActionError = "";
            ResetProduct();
            successMessage = "Đã lưu sản phẩm.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save Admin product.");
            productActionError = "Không thể lưu sản phẩm. Vui lòng kiểm tra thông tin và thử lại.";
        }
    }

    private void EditProduct(ProductManage item)
    {
        productDraft = new ProductManage(item.MaSP, item.MaLoai, item.TenSP, item.MoTa, item.DonViTinh, item.GiaNiemYet, item.GiaBan, item.TrangThai);
        productEditing = true;
    }

    private void ResetProduct()
    {
        productDraft = new ProductManage { TrangThai = "1" };
        productEditing = false;
    }

    private void DeactivateProduct(ProductManage item)
    {
        try { ProductService.Delete(item.MaSP); products = ProductService.Read(); productError = ""; productActionError = ""; }
        catch (ArgumentException ex) { productActionError = ex.Message; }
        catch (InvalidOperationException ex) { productActionError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to deactivate Admin product {ProductCode}.", item.MaSP);
            productActionError = "Không thể cập nhật sản phẩm. Vui lòng thử lại.";
        }
    }

    private void SaveCategory()
    {
        try
        {
            ProductService.SaveCategory(categoryDraft);
            productCategories = ProductService.ReadCategories();
            categoryDraft = new ProductCategory();
            categoryEditing = false;
            productError = "";
            productActionError = "";
        }
        catch (ArgumentException ex) { productActionError = ex.Message; }
        catch (InvalidOperationException ex) { productActionError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save Admin product category.");
            productActionError = "Không thể lưu loại sản phẩm. Vui lòng kiểm tra thông tin và thử lại.";
        }
    }

    private void EditCategory(ProductCategory category)
    {
        categoryDraft = new ProductCategory { MaLoai = category.MaLoai, TrangThai = category.TrangThai };
        categoryEditing = true;
    }

    private void DeactivateCategory(ProductCategory category)
    {
        try
        {
            ProductService.SaveCategory(new ProductCategory { MaLoai = category.MaLoai, TrangThai = false });
            productCategories = ProductService.ReadCategories();
            productError = "";
            productActionError = "";
        }
        catch (ArgumentException ex) { productActionError = ex.Message; }
        catch (InvalidOperationException ex) { productActionError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to deactivate Admin product category {CategoryCode}.", category.MaLoai);
            productActionError = "Không thể cập nhật loại sản phẩm. Vui lòng thử lại.";
        }
    }

    private void ShowStock(ProductManage item)
    {
        selectedProduct = item;
        stockLoading = true;
        stockLoaded = false;
        try { selectedStock = ProductService.ReadStock(item.MaSP); stockLoaded = true; stockError = ""; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load stock for Admin product {ProductCode}.", item.MaSP);
            selectedStock = [];
            stockError = "Không thể tải tồn kho sản phẩm. Vui lòng thử lại.";
        }
        finally { stockLoading = false; }
    }
}
