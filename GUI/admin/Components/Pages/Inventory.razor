@page "/admin/inventory"
@layout SmartShop.Admin.Components.Layout.AdminLayout
@inject WarehouseService WarehouseService
@inject ISupplierService SupplierService
@inject ProductManageService ProductService
@inject ILogger<Inventory> Logger

<PageTitle>Kho và nhập hàng — SmartShop</PageTitle>
<div class="section-heading customer-heading">
    <div><div class="eyebrow red">SMARTSHOP / KHO & NHẬP HÀNG</div><h1>Kho và phiếu nhập</h1><p class="subtitle">Lưu phiếu nhập, chi tiết và cập nhật tồn kho cùng lúc.</p></div>
</div>
@if (!string.IsNullOrEmpty(message))
{
    <div class="customer-feedback @(failed ? "error" : "")" role="status">@message</div>
}
@if (loading)
{
    <p role="status">Đang tải dữ liệu kho và phiếu nhập...</p>
}
else if (!loaded)
{
    <div class="customer-feedback error" role="alert">@loadError <button type="button" @onclick="Load">Thử lại</button></div>
}
<section class="panel">
    <h2>Danh sách kho</h2>
    <div class="form-grid">
        <label>Mã kho<input @bind="warehouseDraft.Code" maxlength="6" disabled="@editingWarehouse" /></label>
        <label>Tên kho<input @bind="warehouseDraft.Name" maxlength="150" /></label>
        <button type="button" @onclick="SaveWarehouse" disabled="@(!loaded)">@(editingWarehouse ? "Cập nhật kho" : "Thêm kho")</button>
        @if (editingWarehouse) { <button type="button" @onclick="ResetWarehouse" disabled="@(!loaded)">Hủy</button> }
    </div>
    @if (loaded) { <DataTable TItem="Warehouse" Items="warehouses" Label="Danh sách kho" ColumnCount="3" EmptyText="Chưa có kho.">
        <Header><th scope="col">Mã kho</th><th scope="col">Tên kho</th><th scope="col">Thao tác</th></Header>
        <RowTemplate Context="warehouse"><td>@warehouse.Code</td><td>@warehouse.Name</td><td><button type="button" @onclick="() => EditWarehouse(warehouse)">Sửa</button><button type="button" @onclick="() => DeleteWarehouse(warehouse)">Xóa</button></td></RowTemplate>
    </DataTable> }
</section>
<section class="panel">
    <h2>Tạo phiếu nhập</h2>
    <div class="form-grid">
        <label>Mã phiếu<input @bind="receiving.Code" maxlength="8" /></label>
        <label>Nhà cung cấp<select @bind="receiving.SupplierCode"><option value="">Chọn nhà cung cấp</option>@foreach (var supplier in suppliers){<option value="@supplier.Code">@supplier.Code — @supplier.Name</option>}</select></label>
        <label>Kho<select @bind="receiving.WarehouseCode"><option value="">Chọn kho</option>@foreach (var warehouse in warehouses){<option value="@warehouse.Code">@warehouse.Code — @warehouse.Name</option>}</select></label>
    </div>
    @foreach (var line in receiving.Lines)
    {
        <div class="form-grid">
            <label>Sản phẩm<select @bind="line.ProductCode"><option value="">Chọn sản phẩm</option>@foreach (var product in products){<option value="@product.MaSP">@product.MaSP — @product.TenSP</option>}</select></label>
            <label>Số lượng<input type="number" min="1" @bind="line.Quantity" /></label>
            <label>Đơn giá nhập<input type="number" min="0.01" step="0.01" @bind="line.UnitCost" /></label>
            <button type="button" @onclick="() => RemoveLine(line)">Bỏ dòng</button>
        </div>
    }
    <div class="customer-actions"><button type="button" @onclick="AddLine" disabled="@(!loaded)">Thêm dòng</button><button type="button" class="primary" @onclick="CreateReceiving" disabled="@(!loaded)">Lưu phiếu và cộng tồn</button></div>
</section>
<section class="panel">
    <h2>Lịch sử phiếu nhập</h2>
    @if (loaded) { <DataTable TItem="ReceivingRecord" Items="receivings" Label="Lịch sử phiếu nhập" ColumnCount="7" EmptyText="Chưa có phiếu nhập.">
        <Header><th scope="col">Mã phiếu</th><th scope="col">Nhà cung cấp</th><th scope="col">Kho</th><th scope="col">Ngày nhập</th><th scope="col">Số dòng</th><th scope="col">Tổng tiền</th><th scope="col">Mã NCC</th></Header>
        <RowTemplate Context="record"><td>@record.Code</td><td>@record.SupplierName</td><td>@record.WarehouseName (@record.WarehouseCode)</td><td>@record.ReceivedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@record.LineCount</td><td>@MoneyFormatter.Format(record.Total)</td><td>@record.SupplierCode</td></RowTemplate>
    </DataTable> }
</section>

@code {
    private List<Warehouse> warehouses = [];
    private List<Supplier> suppliers = [];
    private List<ProductManage> products = [];
    private IReadOnlyList<ReceivingRecord> receivings = [];
    private Warehouse warehouseDraft = new();
    private ReceivingDraft receiving = new() { Lines = [new ReceivingLineDraft()] };
    private bool editingWarehouse, failed, loading = true, loaded;
    private string message = "", loadError = "";

    protected override void OnInitialized() => Load();

    private void Load()
    {
        loading = true;
        loaded = false;
        try
        {
            warehouses = WarehouseService.GetAll().ToList();
            suppliers = SupplierService.Search().ToList();
            products = ProductService.Read();
            receivings = WarehouseService.GetReceivings();
            if (string.IsNullOrWhiteSpace(warehouseDraft.Code)) warehouseDraft.Code = WarehouseService.SuggestCode();
            if (string.IsNullOrWhiteSpace(receiving.Code)) receiving.Code = SuggestReceivingCode();
            loadError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin warehouse and receiving data.");
            warehouses = [];
            suppliers = [];
            products = [];
            receivings = [];
            loadError = "Không thể tải dữ liệu kho và phiếu nhập. Vui lòng thử lại.";
        }
        finally { loading = false; }
    }

    private void SaveWarehouse()
    {
        try { WarehouseService.Save(warehouseDraft, editingWarehouse); message = "Đã lưu kho."; failed = false; ResetWarehouse(); Load(); }
        catch (InvalidOperationException ex) { message = ex.Message; failed = true; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save Admin warehouse."); message = "Không thể lưu kho. Vui lòng thử lại."; failed = true; }
    }

    private void EditWarehouse(Warehouse value)
    {
        warehouseDraft = new Warehouse { Code = value.Code, Name = value.Name };
        editingWarehouse = true;
    }

    private void ResetWarehouse()
    {
        warehouseDraft = new Warehouse { Code = WarehouseService.SuggestCode() };
        editingWarehouse = false;
    }

    private void DeleteWarehouse(Warehouse value)
    {
        try { WarehouseService.Delete(value.Code); message = "Đã xóa kho."; failed = false; Load(); }
        catch (InvalidOperationException ex) { message = ex.Message; failed = true; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to delete Admin warehouse."); message = "Không thể xóa kho. Vui lòng thử lại."; failed = true; }
    }

    private void AddLine() => receiving.Lines.Add(new ReceivingLineDraft());
    private void RemoveLine(ReceivingLineDraft line) { if (receiving.Lines.Count > 1) receiving.Lines.Remove(line); }

    private void CreateReceiving()
    {
        try
        {
            WarehouseService.CreateReceiving(receiving);
            message = "Đã tạo phiếu nhập và cập nhật tồn kho nguyên tử.";
            failed = false;
            receiving = new ReceivingDraft { Code = SuggestReceivingCode(), Lines = [new ReceivingLineDraft()] };
            Load();
        }
        catch (InvalidOperationException ex) { message = ex.Message; failed = true; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to create Admin receiving record."); message = "Không thể lưu phiếu nhập. Vui lòng thử lại."; failed = true; }
    }

    private string SuggestReceivingCode()
    {
        HashSet<string> existing = receivings.Select(item => item.Code).ToHashSet(StringComparer.OrdinalIgnoreCase);
        for (int i = 1; i <= 99999; i++) { string code = $"PN{i:00000}"; if (!existing.Contains(code)) return code; }
        return "";
    }
}
