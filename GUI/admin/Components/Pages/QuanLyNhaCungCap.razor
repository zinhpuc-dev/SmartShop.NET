@attribute [Authorize(Policy = AdminLoginService.Policy)]
@page "/admin/suppliers"
@layout SmartShop.Admin.Components.Layout.BoCucQuanTri
@inject INhaCungCapBUS NhaCungCapBUS
@inject ILogger<QuanLyNhaCungCap> Logger

<PageTitle>Quản lý nhà cung cấp — SmartShop</PageTitle>
<div class="section-heading customer-heading">
    <div>
        <div class="eyebrow red">SMARTSHOP / NHÀ CUNG CẤP</div>
        <h1>Quản lý nhà cung cấp</h1>
        <p class="subtitle">Thông tin liên hệ nhà cung cấp.</p>
    </div>
    <button type="button" class="primary" @onclick="Them" disabled="@(loading || !string.IsNullOrEmpty(loadError))">+ Thêm nhà cung cấp</button>
</div>
<p class="customer-help">Xóa bị chặn khi nhà cung cấp đã có phiếu nhập liên kết.</p>
@if (!string.IsNullOrEmpty(message))
{
    <div class="customer-feedback @(failed ? "error" : "")" role="status">@message</div>
}
<section class="panel">
    @if (loading)
    {
        <p role="status">Đang tải nhà cung cấp...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="customer-feedback error" role="alert">@loadError <button type="button" @onclick="TaiDanhSach">Thử lại</button></div>
    }
    else
    {
    <div class="customer-toolbar">
        <div class="customer-search"><input aria-label="Tìm nhà cung cấp" placeholder="Tìm mã, tên, điện thoại, email..." @bind="query" @bind:event="oninput" /></div>
        <button type="button" class="text-button" @onclick='() => query = ""'>Xóa tìm kiếm</button>
    </div>
    <TimKiemNangCao Fields="TimKiemDanhMucNangCao.TruongNhaCungCap" OnApply="ApDungTimKiemNangCao" Error="@filterError" AppliedFilter="advancedFilter" />
    <OChonNhaCungCap @bind-Value="selectedLookup" />
    <p class="customer-help">@Rows.Count kết quả · Có thể cuộn ngang bảng trên điện thoại.</p>
    <DataTable TItem="NhaCungCapDTO" Items="Rows" Label="Danh sách nhà cung cấp" ColumnCount="5" EmptyText="Không tìm thấy nhà cung cấp phù hợp.">
        <Header><th scope="col">Mã</th><th scope="col">Nhà cung cấp</th><th scope="col">Điện thoại</th><th scope="col">Địa chỉ</th><th scope="col">Thao tác</th></Header>
        <RowTemplate Context="supplier">
            <td>@supplier.Code</td>
            <td><strong>@supplier.Name</strong><small>@supplier.Email</small></td>
            <td>@supplier.Phone</td>
            <td>@supplier.Address</td>
            <td><div class="customer-row-actions">
                <button type="button" class="text-button" aria-label="Sửa @supplier.Code" @onclick="() => MoFormSua(supplier)">Sửa</button>
                <button type="button" class="text-button customer-danger" aria-label="Xóa @supplier.Code" @onclick="() => deleting = supplier">Xóa</button>
            </div></td>
        </RowTemplate>
    </DataTable>
    }
</section>

@if (editorOpen)
{
    <ModalDialog Label="@(editingCode is null ? "Thêm nhà cung cấp" : "Sửa nhà cung cấp")" CssClass="customer-editor-modal" CloseOnBackdrop="false" OnClose="DongForm">
        <h2>@(editingCode is null ? "Thêm nhà cung cấp" : "Sửa nhà cung cấp")</h2>
        <FormNhaCungCap Model="draft" IsEditing="@(editingCode is not null)" Error="@formError" OnSave="Luu" OnCancel="DongForm" />
    </ModalDialog>
}
@if (deleting is not null)
{
    <ModalDialog Label="Xác nhận xóa nhà cung cấp" CssClass="narrow" OnClose="() => deleting = null">
        <h2>Xóa nhà cung cấp?</h2>
        <p>Bạn đang xóa <strong>@deleting.Code — @deleting.Name</strong>. Không thể xóa nhà cung cấp đang được liên kết với phiếu nhập.</p>
        <div class="customer-actions">
            <button type="button" class="primary" @onclick="Xoa">Xác nhận xóa</button>
            <button type="button" class="secondary" @onclick="() => deleting = null">Giữ lại</button>
        </div>
    </ModalDialog>
}
@code {
    private BoLocDanhMuc? advancedFilter;
    private string filterError = "";

    private void ApDungTimKiemNangCao(BoLocDanhMuc? filter)
    {
        try
        {
            _ = NhaCungCapBUS.TimKiem(query, filter);
            advancedFilter = filter;
            filterError = "";
        }
        catch (ArgumentException ex) { filterError = ex.Message; }
    }

    private string query = "", message = "", formError = "", loadError = "";
    private bool editorOpen, failed, loading = true;
    private string? editingCode;
    private DuLieuNhaCungCap draft = new();
    private NhaCungCapDTO? deleting, selectedLookup;
    private IReadOnlyList<NhaCungCapDTO> Rows => string.IsNullOrEmpty(loadError) ? NhaCungCapBUS.TimKiem(query, advancedFilter) : Array.Empty<NhaCungCapDTO>();

    protected override void OnInitialized() => TaiDanhSach();

    private void TaiDanhSach()
    {
        loading = true;
        try
        {
            NhaCungCapBUS.TaiLai();
            _ = NhaCungCapBUS.TimKiem();
            loadError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin suppliers.");
            loadError = "Không thể tải danh sách nhà cung cấp. Vui lòng kiểm tra kết nối và thử lại.";
        }
        finally { loading = false; }
    }

    private void Them()
    {
        if (loading || !string.IsNullOrEmpty(loadError)) return;
        editingCode = null;
        draft = new DuLieuNhaCungCap { Code = NhaCungCapBUS.GoiYMa() };
        formError = "";
        editorOpen = true;
    }
    private void MoFormSua(NhaCungCapDTO supplier)
    {
        editingCode = supplier.Code;
        draft = DuLieuNhaCungCap.TuDuLieu(supplier);
        formError = "";
        editorOpen = true;
    }
    private void DongForm() { editorOpen = false; formError = ""; }
    private void Luu()
    {
        try
        {
            var saved = editingCode is string code ? NhaCungCapBUS.Sua(code, draft) : NhaCungCapBUS.Them(draft);
            if (selectedLookup?.Code == saved.Code) selectedLookup = saved;
            DongForm();
            query = "";
            ThongBao($"Đã lưu nhà cung cấp {saved.Code}.");
        }
        catch (ArgumentException ex) { formError = ex.Message; }
        catch (InvalidOperationException ex) { formError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save Admin supplier."); formError = "Không thể lưu nhà cung cấp. Vui lòng thử lại."; }
    }
    private void Xoa()
    {
        if (deleting is null) return;
        try
        {
            var code = deleting.Code;
            NhaCungCapBUS.Xoa(deleting.Code);
            if (selectedLookup?.Code == deleting.Code) selectedLookup = null;
            deleting = null;
            ThongBao($"Đã xóa nhà cung cấp {code}.");
        }
        catch (InvalidOperationException ex) { deleting = null; ThongBao(ex.Message, true); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to delete Admin supplier."); deleting = null; ThongBao("Không thể xóa nhà cung cấp. Vui lòng thử lại.", true); }
    }
    private void ThongBao(string text, bool error = false) { message = text; failed = error; }
}
