@attribute [Authorize(Policy = AdminLoginService.Policy)]
@page "/admin/employees"
@layout SmartShop.Admin.Components.Layout.BoCucQuanTri
@inject INhanVienBUS NhanVienBUS
@inject ILogger<QuanLyNhanVien> Logger

<PageTitle>Quản lý nhân viên — SmartShop</PageTitle>
<div class="section-heading customer-heading">
    <div>
        <div class="eyebrow red">SMARTSHOP / NHÂN VIÊN</div>
        <h1>Quản lý nhân viên</h1>
        <p class="subtitle">Hồ sơ nhân viên, bao gồm chức vụ.</p>
    </div>
    <button type="button" class="primary" @onclick="Them" disabled="@(loading || !string.IsNullOrEmpty(loadError))">+ Thêm nhân viên</button>
</div>
<p class="customer-help">Quản lý hồ sơ nhân viên và chức vụ.</p>
@if (!string.IsNullOrEmpty(message))
{
    <div class="customer-feedback @(failed ? "error" : "")" role="status">@message</div>
}
<section class="panel">
    @if (loading)
    {
        <p role="status">Đang tải nhân viên...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="customer-feedback error" role="alert">@loadError <button type="button" @onclick="TaiDanhSach">Thử lại</button></div>
    }
    else
    {
    <div class="customer-toolbar">
        <div class="customer-search"><input aria-label="Tìm nhân viên" placeholder="Tìm mã, họ tên, điện thoại, email..." @bind="query" @bind:event="oninput" /></div>
        <button type="button" class="text-button" @onclick='() => query = ""'>Xóa tìm kiếm</button>
    </div>
    <TimKiemNangCao Fields="TimKiemDanhMucNangCao.TruongNhanVien" OnApply="ApDungTimKiemNangCao" Error="@filterError" AppliedFilter="advancedFilter" />
    <OChonNhanVien @bind-Value="selectedLookup" />
    @if (selectedLookup is not null)
    {
        <button type="button" class="text-button" @onclick="() => profile = selectedLookup">Xem hồ sơ đã chọn ↗</button>
    }
    <p class="customer-help">@Rows.Count kết quả · Có thể cuộn ngang bảng trên điện thoại.</p>
    <DataTable TItem="NhanVienDTO" Items="Rows" Label="Danh sách nhân viên" ColumnCount="5" EmptyText="Không tìm thấy nhân viên phù hợp.">
        <Header><th scope="col">Mã</th><th scope="col">Nhân viên</th><th scope="col">Chức vụ</th><th scope="col">Điện thoại</th><th scope="col">Thao tác</th></Header>
        <RowTemplate Context="employee">
            <td>@employee.Code</td>
            <td><strong>@employee.Name</strong><small>@employee.Email</small></td>
            <td>@employee.Position</td>
            <td>@employee.Phone</td>
            <td><div class="customer-row-actions">
                <button type="button" class="text-button" aria-label="Xem hồ sơ @employee.Code" @onclick="() => profile = employee">Hồ sơ</button>
                <button type="button" class="text-button" aria-label="Sửa @employee.Code" @onclick="() => MoFormSua(employee)">Sửa</button>
                <button type="button" class="text-button customer-danger" aria-label="Xóa @employee.Code" @onclick="() => deleting = employee">Xóa</button>
            </div></td>
        </RowTemplate>
    </DataTable>
    }
</section>

@if (editorOpen)
{
    <ModalDialog Label="@(editingCode is null ? "Thêm nhân viên" : "Sửa nhân viên")" CssClass="customer-editor-modal" CloseOnBackdrop="false" OnClose="DongForm">
        <h2>@(editingCode is null ? "Thêm nhân viên" : "Sửa nhân viên")</h2>
        <FormNhanVien Model="draft" IsEditing="@(editingCode is not null)" Error="@formError" OnSave="Luu" OnCancel="DongForm" />
    </ModalDialog>
}
@if (profile is not null)
{
    <ModalDialog Label="Hồ sơ nhân viên" CssClass="customer-editor-modal" OnClose="() => profile = null">
        <h2>Hồ sơ nhân viên</h2>
        <HoSoNhanVien Value="profile" />
    </ModalDialog>
}
@if (deleting is not null)
{
    <ModalDialog Label="Xác nhận xóa nhân viên" CssClass="narrow" OnClose="() => deleting = null">
        <h2>Xóa nhân viên?</h2>
        <p>Bạn đang xóa <strong>@deleting.Code — @deleting.Name</strong>. Không thể xóa nhân viên đang được liên kết với hóa đơn.</p>
        <div class="customer-actions">
            <button type="button" class="primary" @onclick="Xoa">Xác nhận xóa</button>
            <button type="button" class="secondary" @onclick="() => deleting = null">Giữ lại</button>
        </div>
    </ModalDialog>
}
@code {
    private BoLocDanhMuc? advancedFilter;
    private string filterError = "";

    private void ApDungTimKiemNangCao(BoLocDanhMuc? filter)
    {
        try
        {
            _ = NhanVienBUS.TimKiem(query, filter);
            advancedFilter = filter;
            filterError = "";
        }
        catch (ArgumentException ex) { filterError = ex.Message; }
    }

    private string query = "", message = "", formError = "", loadError = "";
    private bool editorOpen, failed, loading = true;
    private string? editingCode;
    private DuLieuNhanVien draft = new();
    private NhanVienDTO? profile, deleting, selectedLookup;
    private IReadOnlyList<NhanVienDTO> Rows => string.IsNullOrEmpty(loadError) ? NhanVienBUS.TimKiem(query, advancedFilter) : Array.Empty<NhanVienDTO>();

    protected override void OnInitialized() => TaiDanhSach();

    private void TaiDanhSach()
    {
        loading = true;
        try
        {
            NhanVienBUS.TaiLai();
            _ = NhanVienBUS.TimKiem();
            loadError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin employees.");
            loadError = "Không thể tải danh sách nhân viên. Vui lòng kiểm tra kết nối và thử lại.";
        }
        finally { loading = false; }
    }

    private void Them()
    {
        if (loading || !string.IsNullOrEmpty(loadError)) return;
        editingCode = null;
        draft = new DuLieuNhanVien { Code = NhanVienBUS.GoiYMa() };
        formError = "";
        editorOpen = true;
    }
    private void MoFormSua(NhanVienDTO employee)
    {
        editingCode = employee.Code;
        draft = DuLieuNhanVien.TuDuLieu(employee);
        formError = "";
        editorOpen = true;
    }
    private void DongForm() { editorOpen = false; formError = ""; }
    private void Luu()
    {
        try
        {
            var saved = editingCode is string code ? NhanVienBUS.Sua(code, draft) : NhanVienBUS.Them(draft);
            if (selectedLookup?.Code == saved.Code) selectedLookup = saved;
            DongForm();
            query = "";
            ThongBao($"Đã lưu nhân viên {saved.Code}.");
        }
        catch (ArgumentException ex) { formError = ex.Message; }
        catch (InvalidOperationException ex) { formError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save Admin employee."); formError = "Không thể lưu nhân viên. Vui lòng thử lại."; }
    }
    private void Xoa()
    {
        if (deleting is null) return;
        try
        {
            var code = deleting.Code;
            NhanVienBUS.Xoa(deleting.Code);
            if (selectedLookup?.Code == deleting.Code) selectedLookup = null;
            deleting = null;
            ThongBao($"Đã xóa nhân viên {code}.");
        }
        catch (InvalidOperationException ex) { deleting = null; ThongBao(ex.Message, true); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to delete Admin employee."); deleting = null; ThongBao("Không thể xóa nhân viên. Vui lòng thử lại.", true); }
    }
    private void ThongBao(string text, bool error = false) { message = text; failed = error; }
}

