@attribute [Authorize(Policy = DangNhapQuanTri.Policy)]
@page "/admin"
@page "/admin/products"
@page "/admin/orders"
@layout SmartShop.Admin.Components.Layout.BoCucQuanTri
@inherits TrangCoSo
@inject SanPhamBUS ProductService
@inject DonHangBUS OrderService
@inject HoaDonBUS InvoiceService
@inject INhanVienBUS NhanVienBUS
@inject IJSRuntime JavaScript
@inject ILogger<QuanTri> Logger
<PageTitle>@Heading — SmartShop</PageTitle>
<div class="section-heading">
    <div>
        <div class="eyebrow red">SMARTSHOP / ADMIN</div>
        <h1>@Heading</h1>
    </div>
</div>
@if (page == "admin")
{
<div class="metrics">
    <div class="panel"><span>Doanh thu theo kỳ</span><h2>@(reportLoaded ? DinhDangTienTe.DinhDang(summary!.Revenue) : "—")</h2><small class="green">Chỉ tính hóa đơn đã thanh toán</small>@if (!reportLoaded && !reportLoading) { <small>@reportError <button type="button" @onclick="TaiBaoCao">Thử lại</button></small> }</div>
    <div class="panel"><span>Đơn hàng</span><h2>@(ordersLoaded ? orders.Count : "—")</h2><small>Đơn hàng trong hệ thống</small>@if (!ordersLoaded && !ordersLoading) { <small>@ordersError <button type="button" @onclick="TaiDonHang">Thử lại</button></small> }</div>
    <div class="panel"><span>Sản phẩm</span><h2>@(productsLoaded ? products.Count : "—")</h2><small>Danh mục sản phẩm</small>@if (!productsLoaded && !productLoading) { <small>@productError <button type="button" @onclick="TaiSanPham">Thử lại</button></small> }</div>
    <div class="panel"><span>Tồn kho</span><h2>@(productsLoaded ? products.Sum(p => p.TongSoLuongTon) : "—")</h2><small>Tổng số lượng trong các kho</small>@if (!productsLoaded && !productLoading) { <small>Chưa thể tải số lượng tồn kho.</small> }</div>
</div>
}
<section class="panel">
    @if (!string.IsNullOrEmpty(successMessage)) { <p class="customer-feedback" role="status">@successMessage</p> }
    @if (page == "admin/products")
    {
        <div class="section-heading customer-heading">
            <h2>Danh sách sản phẩm</h2>
            <div class="customer-row-actions">
                <button type="button" class="secondary" @onclick="MoLoaiSanPham" disabled="@(!productLoaded)">Quản lý loại</button>
                <button type="button" class="primary" @onclick="MoFormThemSanPham" disabled="@(!productLoaded)">+ Thêm sản phẩm</button>
            </div>
        </div>
        @if (!categoryDialogOpen && !string.IsNullOrEmpty(productActionError)) { <div class="customer-feedback error" role="alert">@productActionError</div> }
        @if (productLoading) { <p role="status">Đang tải sản phẩm...</p> }
        else if (!productLoaded) { <div class="customer-feedback error" role="alert">@productError <button type="button" @onclick="TaiSanPham">Thử lại</button></div> }
        else
        {
        @if (categoryDialogOpen)
        {
            <HopThoai Label="Quản lý loại sản phẩm" CssClass="customer-editor-modal" CloseOnBackdrop="false" OnClose="DongLoaiSanPham">
                <h2>Quản lý loại sản phẩm</h2>
                @if (!string.IsNullOrEmpty(productActionError)) { <div class="customer-feedback error" role="alert">@productActionError</div> }
                <div class="form-grid">
                    <label>Mã loại<input @bind="categoryDraft.MaLoai" maxlength="6" disabled="@categoryEditing" /></label>
                    <label>Trạng thái loại<select @bind="categoryDraft.TrangThai"><option value="true">Đang hoạt động</option><option value="false">Ngừng hoạt động</option></select></label>
                    <button type="button" @onclick="LuuLoaiSanPham" disabled="@(!productLoaded)">@(categoryEditing ? "Cập nhật loại" : "Thêm loại")</button>
                </div>
                <BangDuLieu TItem="LoaiSanPhamDTO" Items="productCategories" Label="Danh sách loại sản phẩm" ColumnCount="3" EmptyText="Chưa có loại sản phẩm.">
                    <Header><th scope="col">Mã loại</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></Header>
                    <RowTemplate Context="category">
                        <td>@category.MaLoai</td><td>@(category.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")</td>
                        <td><button type="button" @onclick="() => SuaLoaiSanPham(category)">Sửa</button><button type="button" @onclick="() => DoiTrangThaiLoaiSanPham(category)">@(category.TrangThai ? "Ngừng" : "Khôi phục")</button></td>
                    </RowTemplate>
                </BangDuLieu>
            </HopThoai>
        }
        @if (productEditorOpen)
        {
            <HopThoai Label="@ProductEditorTitle" CssClass="customer-editor-modal customer-editor" CloseOnBackdrop="false" OnClose="DatLaiSanPham">
                <h2>@ProductEditorTitle</h2>
                @if (!string.IsNullOrEmpty(productFormError))
                {
                    <p class="customer-feedback error" role="alert">@productFormError</p>
                }
                <div class="customer-form-grid">
                    <label>Mã sản phẩm<input @bind="productDraft.MaSP" maxlength="8" disabled="@productEditing" /></label>
                    <label>Loại sản phẩm<select @bind="productDraft.MaLoai"><option value="">Chọn loại</option>@foreach (var category in productCategories.Where(c => c.TrangThai || c.MaLoai == productDraft.MaLoai)){<option value="@category.MaLoai">@category.MaLoai</option>}</select></label>
                    <label>Tên sản phẩm<input @bind="productDraft.TenSP" maxlength="200" /></label>
                    <label>Đơn vị tính<input @bind="productDraft.DonViTinh" maxlength="30" /></label>
                    <label>Giá niêm yết<input type="number" min="0" step="0.01" @bind="productDraft.GiaNiemYet" /></label>
                    <label>Giá bán<input type="number" min="0" step="0.01" @bind="productDraft.GiaBan" /></label>
                    <label>Trạng thái<select @bind="productDraft.TrangThai"><option value="1">Đang bán</option><option value="0">Ngừng bán</option></select></label>
                    <label class="customer-span-all">Mô tả<textarea @bind="productDraft.MoTa" maxlength="65535"></textarea></label>
                </div>
                <div class="customer-actions">
                    <button type="button" class="primary" @onclick="LuuSanPhamQuanTri">@(productEditing ? "Cập nhật sản phẩm" : "Lưu sản phẩm")</button>
                    <button type="button" class="secondary" @onclick="DatLaiSanPham">Hủy</button>
                </div>
            </HopThoai>
        }
        <div class="customer-toolbar">
            <div class="customer-search">
                <input aria-label="Tìm sản phẩm" placeholder="Tìm theo mã hoặc tên sản phẩm" @bind="productSearch" @bind:event="oninput" />
            </div>
            <select aria-label="Lọc theo loại sản phẩm" @bind="productCategoryFilter">
                <option value="">Tất cả loại sản phẩm</option>
                @foreach (var category in productCategories)
                {
                    <option value="@category.MaLoai">@category.MaLoai</option>
                }
            </select>
        </div>
        <TimKiemNangCao Fields="TimKiemDanhMucNangCao.TruongSanPham" OnApply="ApDungTimKiemSanPhamNangCao" Error="@productFilterError" AppliedFilter="advancedProductFilter" />
        <BangDuLieu TItem="SanPhamQuanTriDTO" Items="FilteredProducts" Label="Danh sách sản phẩm" ColumnCount="7" EmptyText="Không có sản phẩm phù hợp.">
            <Header>
                <th scope="col">Sản phẩm</th><th scope="col">Mã danh mục</th><th scope="col">Giá bán</th><th scope="col">Giá niêm yết</th><th scope="col">Tồn</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th>
            </Header>
            <RowTemplate Context="product">
                <td><strong>@product.TenSP</strong><small>@product.MaSP</small></td>
                <td>@product.MaLoai</td>
                <td>@DinhDangTienTe.DinhDang(product.GiaBan)</td>
                <td>@DinhDangTienTe.DinhDang(product.GiaNiemYet)</td>
                <td>@product.TongSoLuongTon</td>
                <td><span class="status @(product.TrangThai == "1" ? "" : "warning")">@(product.TrangThai == "1" ? "Đang bán" : "Ngừng bán")</span></td>
                <td><button type="button" @onclick="() => MoFormSuaSanPham(product)">Sửa</button><button type="button" @onclick="() => XemTonKho(product)">Tồn kho</button><button type="button" @onclick='() => DoiTrangThaiSanPham(product, product.TrangThai != "1")'>@(product.TrangThai == "1" ? "Ngừng bán" : "Khôi phục")</button><button type="button" class="text-button customer-danger" @onclick="() => XacNhanXoaSanPham(product)">Xóa</button></td>
            </RowTemplate>
        </BangDuLieu>
        @if (productToDelete is not null)
        {
            <HopThoai Label="Xác nhận xóa sản phẩm" CssClass="narrow" CloseOnBackdrop="false" OnClose="DongXacNhanXoaSanPham">
                <h2>Xóa sản phẩm?</h2>
                <p>Bạn đang xóa vĩnh viễn <strong>@productToDelete.MaSP — @productToDelete.TenSP</strong>.</p>
                @if (!string.IsNullOrEmpty(productDeleteError))
                {
                    <p class="customer-feedback error" role="alert">@productDeleteError</p>
                }
                <div class="customer-actions">
                    <button type="button" class="primary" @onclick="XoaSanPham">Xác nhận xóa</button>
                    <button type="button" class="secondary" @onclick="DongXacNhanXoaSanPham">Hủy</button>
                </div>
            </HopThoai>
        }
        @if (selectedProduct is not null)
        {
            <HopThoai Label="Tồn kho sản phẩm" CssClass="customer-editor-modal" OnClose="() => selectedProduct = null">
                <h3>Tồn kho @selectedProduct.TenSP</h3>
                @if (stockLoading) { <p role="status">Đang tải tồn kho...</p> }
                else if (!stockLoaded) { <div class="customer-feedback error" role="alert">@stockError <button type="button" @onclick="() => XemTonKho(selectedProduct)">Thử lại</button></div> }
                else { <BangDuLieu TItem="TonKhoSanPhamDTO" Items="selectedStock" Label="Tồn kho theo kho" ColumnCount="3" EmptyText="Chưa có dữ liệu tồn kho.">
                    <Header><th scope="col">Mã kho</th><th scope="col">Kho</th><th scope="col">Số lượng</th></Header>
                    <RowTemplate Context="stock"><td>@stock.MaKho</td><td>@stock.TenKho</td><td>@stock.SoLuongTon</td></RowTemplate>
                </BangDuLieu> }
            </HopThoai>
        }
        }
    }
    else if (page == "admin/orders")
    {
        <h2>Quản lý đơn hàng</h2>
        <div class="form-grid">
            <label>Tìm đơn hàng<input placeholder="Mã đơn, khách hàng" @bind="orderSearch" @bind:event="oninput" /></label>
            <label>Trạng thái<select @bind="orderFilter"><option value="">Tất cả</option><option>Đang xử lý</option><option>Đã xác nhận</option><option>Đang giao hàng</option><option>Đã giao</option><option>Hoàn thành</option><option>Đã hủy</option></select></label>
            <button type="button" @onclick="TaiDonHang">Tải lại</button>
        </div>
        @if (ordersLoading) { <p role="status">Đang tải đơn hàng...</p> }
        else if (!ordersLoaded) { <div class="customer-feedback error" role="alert">@ordersError <button type="button" @onclick="TaiDonHang">Thử lại</button></div> }
        else
        {
        @if (!string.IsNullOrEmpty(warehouseError)) { <div class="customer-feedback error" role="alert">@warehouseError <button type="button" @onclick="TaiDonHang">Thử lại</button></div> }
        @if (!string.IsNullOrEmpty(orderActionError)) { <div class="customer-feedback error" role="alert">@orderActionError</div> }
        <BangDuLieu TItem="DonHangQuanTriDTO" Items="FilteredOrders" Label="Danh sách đơn hàng" ColumnCount="7" EmptyText="Chưa có đơn hàng.">
            <Header><th scope="col">Đơn hàng / khách hàng</th><th scope="col">Ngày tạo</th><th scope="col">Chi tiết</th><th scope="col">Kho xuất</th><th scope="col">Tổng tiền</th><th scope="col">Trạng thái</th><th scope="col">Lưu</th></Header>
            <RowTemplate Context="order">
                <td><strong>@order.Code</strong><small>@order.CustomerName (@order.CustomerCode)</small><small>@order.Address</small></td>
                <td>@order.Created.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@foreach (var line in order.Lines){<small>@line.ProductName × @line.Quantity — @DinhDangTienTe.DinhDang(line.LineTotal)</small>}</td>
                <td><select aria-label="Kho xuất @order.Code" @bind="warehouseSelection[order.Code]"><option value="">Chọn kho</option>@foreach(var warehouse in warehouses){<option value="@warehouse.Code">@warehouse.Code — @warehouse.Name</option>}</select></td>
                <td>@DinhDangTienTe.DinhDang(order.Total)</td>
                <td><select aria-label="Trạng thái @order.Code" @bind="statusSelection[order.Code]"><option>Đang xử lý</option><option>Đã xác nhận</option><option>Đang giao hàng</option><option>Đã giao</option><option>Hoàn thành</option><option>Đã hủy</option></select></td>
                <td><button type="button" @onclick="() => LuuTrangThaiDonHang(order.Code)" disabled="@(!string.IsNullOrEmpty(warehouseError))">Lưu</button></td>
            </RowTemplate>
        </BangDuLieu>
        }
        <h2>Hóa đơn</h2>
        <h3>Lập hóa đơn</h3>
        <div class="form-grid">
            <label>Đơn đã giao<select @bind="invoiceOrder"><option value="">Chọn đơn hàng</option>
                @foreach (var order in orders.Where(o => o.InvoiceCode is null && (o.Status == "Đã giao" || o.Status == "Hoàn thành")))
                { <option value="@order.Code">@order.Code — @order.CustomerName</option> }
            </select></label>
            <OChonNhanVien @bind-Value="nhanVienLapHoaDon" Disabled="@(!invoiceEmployeesLoaded)" />
            <label>Thanh toán<select @bind="invoiceMethod"><option>Tiền mặt</option><option>Chuyển khoản</option><option>COD</option></select></label>
            <button type="button" @onclick="LapHoaDon" disabled="@(!ordersLoaded || !invoiceEmployeesLoaded)">Lập hóa đơn</button>
        </div>
        @if (!invoiceEmployeesLoaded) { <p class="customer-feedback error">Chưa tải được nhân viên lập hóa đơn. <button @onclick="TaiNhanVienLapHoaDon">Thử lại</button></p> }
        @if (!string.IsNullOrEmpty(invoiceActionError)) { <p class="customer-feedback error" role="alert">@invoiceActionError</p> }
        @if (invoicesLoading) { <p role="status">Đang tải hóa đơn...</p> }
        else if (!invoicesLoaded) { <div class="customer-feedback error" role="alert">@invoiceError <button type="button" @onclick="TaiHoaDon">Thử lại</button></div> }
        else
        {
        <BangDuLieu TItem="HoaDonDTO" Items="invoices" Label="Hóa đơn" ColumnCount="7" EmptyText="Chưa có hóa đơn.">
            <Header><th scope="col">Hóa đơn</th><th scope="col">Đơn hàng</th><th scope="col">Nhân viên</th><th scope="col">Thời gian</th><th scope="col">Chi tiết</th><th scope="col">Tổng thanh toán</th><th scope="col">Thu tiền</th></Header>
            <RowTemplate Context="invoice"><td>@invoice.Code<small>@invoice.PaymentMethod · @invoice.Status</small></td><td>@invoice.OrderCode</td><td>@invoice.EmployeeName (@invoice.EmployeeCode)</td><td>@invoice.Created.ToString("yyyy-MM-dd HH:mm")</td><td>@foreach(var line in invoice.Lines){<small>@line.ProductName × @line.Quantity</small>}</td><td>@DinhDangTienTe.DinhDang(invoice.Total)</td><td>@if (invoice.Status == "Chờ thanh toán") { <button type="button" @onclick="() => ThuTienHoaDon(invoice)">Xác nhận đã thu tiền</button> }</td></RowTemplate>
        </BangDuLieu>
        }
    }
    else
    {
        <h2>Thống kê bán hàng</h2>
        <BoLocThoiGian Value="boLocBaoCao" OnApplied="ApDungThoiGianThongKe" Disabled="reportLoading" />
        @if (reportLoaded) { <p>@summary!.From.ToString("yyyy-MM-dd") — @summary.To.AddDays(-1).ToString("yyyy-MM-dd") · @summary.OrderCount đơn có hóa đơn đã thanh toán · @summary.InvoiceCount hóa đơn đã thanh toán · @summary.ProductsSold sản phẩm bán</p> }
        else if (reportLoading) { <p role="status">Đang tải báo cáo...</p> }
        else { <div class="customer-feedback error" role="alert">@reportError <button type="button" @onclick="TaiBaoCao">Thử lại</button></div> }
        @if (reportLoaded) { <strong>Doanh thu: @DinhDangTienTe.DinhDang(summary!.Revenue)</strong> }
    }
</section>

@code {
    private string Heading => page switch
    {
        "admin/products" => "Sản phẩm",
        "admin/orders" => "Đơn hàng",
        _ => "Tổng quan cửa hàng"
    };
    private string? loadedPage;
    private BoLocDanhMuc? advancedProductFilter;
    private string productFilterError = "";

    private void ApDungTimKiemSanPhamNangCao(BoLocDanhMuc? filter)
    {
        try
        {
            _ = ProductService.TimKiem(productSearch, productCategoryFilter, filter);
            advancedProductFilter = filter;
            productFilterError = "";
        }
        catch (ArgumentException ex) { productFilterError = ex.Message; }
    }

    private List<SanPhamQuanTriDTO> products = [];
    private string productSearch = "", orderSearch = "", orderFilter = "";
    private string productCategoryFilter = "";
    private IEnumerable<SanPhamQuanTriDTO> FilteredProducts => productLoaded
        ? ProductService.TimKiem(productSearch, productCategoryFilter, advancedProductFilter)
        : Enumerable.Empty<SanPhamQuanTriDTO>();
    private IEnumerable<DonHangQuanTriDTO> FilteredOrders => orders.Where(o => (string.IsNullOrEmpty(orderFilter) || o.Status == orderFilter)
        && (string.IsNullOrWhiteSpace(orderSearch) || o.Code.Contains(orderSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || o.CustomerName.Contains(orderSearch.Trim(), StringComparison.OrdinalIgnoreCase)));
    private List<LoaiSanPhamDTO> productCategories = [];
    private SanPhamQuanTriDTO productDraft = new() { TrangThai = "1" };
    private LoaiSanPhamDTO categoryDraft = new();
    private List<TonKhoSanPhamDTO> selectedStock = [];
    private SanPhamQuanTriDTO? selectedProduct;
    private SanPhamQuanTriDTO? productToDelete;
    private string productDeleteError = "";
    private bool stockLoading, stockLoaded;
    private string stockError = "Không thể tải tồn kho sản phẩm. Vui lòng thử lại.";
    private bool productEditing;
    private bool productEditorOpen;
    private string productFormError = "";
    private string ProductEditorTitle => productEditing ? "Sửa sản phẩm" : "Thêm sản phẩm";
    private bool categoryEditing;
    private bool categoryDialogOpen;
    private string productError = "Không thể tải danh sách sản phẩm. Vui lòng kiểm tra kết nối và thử lại.";
    private string productActionError = "";
    private string successMessage = "";
    private bool productLoading = true;
    private bool productLoaded;
    private bool productsLoaded;
    private List<DonHangQuanTriDTO> orders = [];
    private IReadOnlyList<KhoDTO> warehouses = [];
    private IReadOnlyList<HoaDonDTO> invoices = [];
    private Dictionary<string, string> statusSelection = [];
    private Dictionary<string, string> warehouseSelection = [];
    private NhanVienDTO? nhanVienLapHoaDon;
    private bool invoiceEmployeesLoaded;
    private string invoiceOrder = "", invoiceMethod = "Tiền mặt", invoiceActionError = "";
    private ThongKeBanHangDTO? summary;
    private BoLocThoiGianThongKe boLocBaoCao = new();
    private string ordersError = "Không thể tải danh sách đơn hàng. Vui lòng thử lại.";
    private string warehouseError = "";
    private string orderActionError = "";
    private string reportError = "Không thể tải báo cáo doanh thu. Vui lòng thử lại.";
    private string invoiceError = "Không thể tải danh sách hóa đơn. Vui lòng thử lại.";
    private bool ordersLoading = true;
    private bool ordersLoaded;
    private bool invoicesLoading = true;
    private bool invoicesLoaded;
    private bool reportLoaded;
    private bool reportLoading = true;

    protected override void OnParametersSet()
    {
        if (loadedPage == page) return;
        loadedPage = page;
        DongXacNhanXoaSanPham();
        DongLoaiSanPham();
        selectedProduct = null;
        DatLaiSanPham();
        successMessage = "";

        if (page is "admin" or "admin/products") TaiSanPham();
        if (page is "admin" or "admin/orders") TaiDonHang();
        if (page == "admin/orders")
        {
            TaiHoaDon();
            TaiNhanVienLapHoaDon();
        }
        if (page == "admin") TaiBaoCao();
    }

    private void TaiSanPham()
    {
        productLoading = true;
        productLoaded = false;
        try
        {
            products = ProductService.DocDanhSach();
            productCategories = ProductService.DocLoaiSanPham();
            productLoaded = productsLoaded = true;
            productError = "";
            productActionError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin product catalog.");
            productLoaded = productsLoaded = false;
            productError = "Không thể tải danh sách sản phẩm. Vui lòng kiểm tra kết nối và thử lại.";
            products = [];
            productCategories = [];
        }
        finally { productLoading = false; }
    }

    private void TaiDonHang()
    {
        ordersLoading = true;
        ordersLoaded = false;
        orderActionError = "";
        ordersError = "Không thể tải danh sách đơn hàng. Vui lòng thử lại.";
        try
        {
            orders = OrderService.DocDonHang().ToList();
            warehouseError = "";
            try { warehouses = OrderService.DocKho(); }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load Admin warehouse options.");
                warehouses = [];
                warehouseError = "Không thể tải danh sách kho. Hãy thử tải lại trước khi cập nhật trạng thái đơn hàng.";
            }
            statusSelection = orders.ToDictionary(o => o.Code, o => o.Status);
            warehouseSelection = orders.ToDictionary(o => o.Code, o => o.WarehouseCode ?? "");
            ordersLoaded = true;
            ordersError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin orders.");
            orders = [];
            ordersError = "Không thể tải danh sách đơn hàng. Vui lòng thử lại.";
        }
        finally { ordersLoading = false; }
    }

    private void TaiNhanVienLapHoaDon()
    {
        try
        {
            var employees = NhanVienBUS.TimKiem();
            if (nhanVienLapHoaDon is not null)
                nhanVienLapHoaDon = employees.SingleOrDefault(employee => employee.Code == nhanVienLapHoaDon.Code);
            invoiceEmployeesLoaded = true;
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load invoice employees."); invoiceEmployeesLoaded = false; }
    }

    private void LapHoaDon()
    {
        invoiceActionError = "";
        try
        {
            InvoiceService.LapHoaDon(invoiceOrder, nhanVienLapHoaDon?.Code ?? "", invoiceMethod);
            invoiceOrder = "";
            TaiHoaDon(); TaiDonHang();
            successMessage = "Đã lập hóa đơn chờ thanh toán.";
        }
        catch (ArgumentException ex) { invoiceActionError = ex.Message; }
        catch (InvalidOperationException ex) { invoiceActionError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to issue invoice."); invoiceActionError = "Không thể lập hóa đơn. Vui lòng thử lại."; }
    }

    private async Task ThuTienHoaDon(HoaDonDTO invoice)
    {
        if (!await JavaScript.InvokeAsync<bool>("confirm", $"Xác nhận đã thu đủ {DinhDangTienTe.DinhDang(invoice.Total)} cho hóa đơn {invoice.Code}?")) return;
        invoiceActionError = "";
        try
        {
            InvoiceService.DanhDauDaThanhToan(invoice.Code);
            TaiHoaDon();
            successMessage = "Đã xác nhận thanh toán hóa đơn.";
        }
        catch (InvalidOperationException ex) { invoiceActionError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to mark invoice paid."); invoiceActionError = "Không thể xác nhận thanh toán. Vui lòng thử lại."; }
    }

    private void TaiHoaDon()
    {
        invoicesLoading = true;
        invoicesLoaded = false;
        invoiceError = "Không thể tải danh sách hóa đơn. Vui lòng thử lại.";
        try
        {
            invoices = InvoiceService.DocHoaDon();
            invoicesLoaded = true;
            invoiceError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin invoices.");
            invoices = [];
            invoiceError = "Không thể tải danh sách hóa đơn. Vui lòng thử lại.";
        }
        finally { invoicesLoading = false; }
    }

    private void ApDungThoiGianThongKe(BoLocThoiGianThongKe boLoc)
    {
        boLocBaoCao = boLoc;
        TaiBaoCao();
    }

    private void TaiBaoCao()
    {
        reportLoading = true;
        reportLoaded = false;
        reportError = "Không thể tải báo cáo doanh thu. Vui lòng thử lại.";
        try
        {
            summary = OrderService.ThongKeBanHang(boLocBaoCao);
            reportLoaded = true;
            reportError = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Admin sales report.");
            summary = null;
            reportError = "Không thể tải báo cáo doanh thu. Vui lòng thử lại.";
        }
        finally { reportLoading = false; }
    }

    private void LuuTrangThaiDonHang(string code)
    {
        try
        {
            OrderService.CapNhatTrangThai(code, statusSelection[code], warehouseSelection[code]);
            TaiDonHang();
            successMessage = "Đã cập nhật đơn hàng.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update order status for {OrderCode}.", code);
            orderActionError = ex.Message.Contains("migration", StringComparison.OrdinalIgnoreCase)
                ? "Chưa thể hoàn tất đơn hàng vì cần thiết lập phân bổ kho. Vui lòng liên hệ người quản lý để hoàn tất thiết lập."
                : ex is InvalidOperationException ? ex.Message : "Không thể cập nhật đơn hàng. Vui lòng kiểm tra thông tin và thử lại.";
        }
    }

    private void LuuSanPhamQuanTri()
    {
        try
        {
            if (productEditing) ProductService.Sua(productDraft); else ProductService.Them(productDraft);
            products = ProductService.DocDanhSach();
            productError = "";
            productActionError = "";
            DatLaiSanPham();
            successMessage = "Đã lưu sản phẩm.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save Admin product.");
            productFormError = ex is ArgumentException or InvalidOperationException
                ? ex.Message : "Không thể lưu sản phẩm. Vui lòng kiểm tra thông tin và thử lại.";
        }
    }

    private void MoFormThemSanPham()
    {
        DatLaiSanPham();
        productEditorOpen = true;
    }

    private void MoFormSuaSanPham(SanPhamQuanTriDTO item)
    {
        productDraft = new SanPhamQuanTriDTO(item.MaSP, item.MaLoai, item.TenSP, item.MoTa, item.DonViTinh, item.GiaNiemYet, item.GiaBan, item.TrangThai);
        productEditing = true;
        productFormError = "";
        productEditorOpen = true;
    }

    private void DatLaiSanPham()
    {
        productDraft = new SanPhamQuanTriDTO { TrangThai = "1" };
        productEditing = false;
        productFormError = "";
        productEditorOpen = false;
    }

    private void XacNhanXoaSanPham(SanPhamQuanTriDTO product)
    {
        successMessage = "";
        productDeleteError = "";
        productToDelete = product;
    }

    private void DongXacNhanXoaSanPham()
    {
        productToDelete = null;
        productDeleteError = "";
    }

    private void XoaSanPham()
    {
        if (productToDelete is not { } product) return;
        try
        {
            ProductService.Xoa(product.MaSP);
            DongXacNhanXoaSanPham();
            TaiSanPham();
            successMessage = "Đã xóa sản phẩm.";
        }
        catch (InvalidOperationException ex) { productDeleteError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete Admin product {ProductCode}.", product.MaSP);
            productDeleteError = "Không thể xóa sản phẩm. Vui lòng thử lại.";
        }
    }

    private void DoiTrangThaiSanPham(SanPhamQuanTriDTO item, bool active)
    {
        try { ProductService.DoiTrangThai(item.MaSP, active); products = ProductService.DocDanhSach(); productError = ""; productActionError = ""; successMessage = active ? "Đã khôi phục sản phẩm." : "Đã ngừng bán sản phẩm."; }
        catch (ArgumentException ex) { productActionError = ex.Message; }
        catch (InvalidOperationException ex) { productActionError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to change status of Admin product {ProductCode}.", item.MaSP);
            productActionError = "Không thể cập nhật sản phẩm. Vui lòng thử lại.";
        }
    }

    private void MoLoaiSanPham()
    {
        DongLoaiSanPham();
        categoryDialogOpen = true;
    }

    private void DongLoaiSanPham()
    {
        categoryDialogOpen = false;
        categoryDraft = new LoaiSanPhamDTO { TrangThai = true };
        categoryEditing = false;
        productActionError = "";
    }

    private void LuuLoaiSanPham()
    {
        try
        {
            ProductService.LuuLoaiSanPham(categoryDraft);
            productCategories = ProductService.DocLoaiSanPham();
            categoryDraft = new LoaiSanPhamDTO();
            categoryEditing = false;
            productError = "";
            productActionError = "";
        }
        catch (ArgumentException ex) { productActionError = ex.Message; }
        catch (InvalidOperationException ex) { productActionError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save Admin product category.");
            productActionError = "Không thể lưu loại sản phẩm. Vui lòng kiểm tra thông tin và thử lại.";
        }
    }

    private void SuaLoaiSanPham(LoaiSanPhamDTO category)
    {
        categoryDraft = new LoaiSanPhamDTO { MaLoai = category.MaLoai, TrangThai = category.TrangThai };
        categoryEditing = true;
    }

    private void DoiTrangThaiLoaiSanPham(LoaiSanPhamDTO category)
    {
        try
        {
            ProductService.LuuLoaiSanPham(new LoaiSanPhamDTO { MaLoai = category.MaLoai, TrangThai = !category.TrangThai });
            productCategories = ProductService.DocLoaiSanPham();
            productError = "";
            productActionError = "";
        }
        catch (ArgumentException ex) { productActionError = ex.Message; }
        catch (InvalidOperationException ex) { productActionError = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to change status of Admin product category {CategoryCode}.", category.MaLoai);
            productActionError = "Không thể cập nhật loại sản phẩm. Vui lòng thử lại.";
        }
    }

    private void XemTonKho(SanPhamQuanTriDTO item)
    {
        selectedProduct = item;
        stockLoading = true;
        stockLoaded = false;
        try { selectedStock = ProductService.DocTonKho(item.MaSP); stockLoaded = true; stockError = ""; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load stock for Admin product {ProductCode}.", item.MaSP);
            selectedStock = [];
            stockError = "Không thể tải tồn kho sản phẩm. Vui lòng thử lại.";
        }
        finally { stockLoading = false; }
    }
}
