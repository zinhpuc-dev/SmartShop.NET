<div class="customer-selector">
    <FormField Label="Nhân viên đã chọn">
        <input readonly value="@Display" aria-label="Nhân viên đã chọn" />
    </FormField>
    <button type="button" class="secondary" aria-label="Tìm và chọn nhân viên" @onclick="() => open = true">… Chọn nhân viên</button>
</div>
@if (open)
{
    <TimChonNhanVien OnSelected="Chon" OnClose="() => open = false" />
}

@code {
    [Parameter] public NhanVienDTO? Value { get; set; }
    [Parameter] public EventCallback<NhanVienDTO?> ValueChanged { get; set; }
    private bool open;
    private string Display => Value is null ? "Chưa chọn nhân viên" : $"{Value.Code} — {Value.Name} — {Value.Phone}";
    private Task Chon(NhanVienDTO employee) => ValueChanged.InvokeAsync(employee);
}
