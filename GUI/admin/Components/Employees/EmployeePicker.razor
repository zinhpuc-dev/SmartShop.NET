@inject IEmployeeService Employees

<ModalDialog Label="Tìm và chọn nhân viên" CssClass="customer-modal" OnClose="OnClose">
    <h2>Tìm và chọn nhân viên</h2>
    <p class="customer-help">Tìm theo mã, tên, chức vụ, số điện thoại hoặc email.</p>
    <div class="customer-search">
        <input aria-label="Tìm nhân viên trong popup" placeholder="Nhập mã, tên, số điện thoại..."
               @bind="query" @bind:event="oninput" />
    </div>
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="customer-feedback error" role="alert">@error</div>
    }
    <DataTable TItem="Employee" Items="Results" Label="Kết quả chọn nhân viên" ColumnCount="3" EmptyText="Không tìm thấy nhân viên phù hợp.">
        <Header><th scope="col">Nhân viên</th><th scope="col">Liên hệ</th><th scope="col">Chọn</th></Header>
        <RowTemplate Context="employee">
            <td><strong>@employee.Name</strong><small>@employee.Code</small></td>
            <td>@employee.Phone<small>@employee.Email</small></td>
            <td><button type="button" class="text-button" aria-label="Chọn @employee.Code" @onclick="() => Choose(employee.Code)">Chọn →</button></td>
        </RowTemplate>
    </DataTable>
    <div class="customer-actions"><button type="button" class="secondary" @onclick="OnClose">Đóng tìm kiếm</button></div>
</ModalDialog>

@code {
    [Parameter] public EventCallback<Employee> OnSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string query = "", error = "";
    private IReadOnlyList<Employee> Results => Employees.Search(query);

    private async Task Choose(string code)
    {
        try
        {
            var value = Employees.Get(code);
            await OnSelected.InvokeAsync(value);
            await OnClose.InvokeAsync();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
