<div class="customer-editor">
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="customer-feedback error" role="alert">@Error</div>
    }
    <ValidatedForm Model="Model" OnValidSubmit="OnSave">
        <div class="customer-form-grid">
            <FormField Label="Mã nhân viên">
                <InputText @bind-Value="Model.Code" readonly="@IsEditing" aria-readonly="@IsEditing" maxlength="8" />
            </FormField>
            <FormField Label="Họ và tên"><InputText @bind-Value="Model.Name" maxlength="150" /></FormField>
            <FormField Label="Chức vụ"><InputText @bind-Value="Model.Position" maxlength="100" /></FormField>
            <FormField Label="Số điện thoại (không bắt buộc)"><InputText @bind-Value="Model.Phone" maxlength="20" inputmode="tel" /></FormField>
            <FormField Label="Email (không bắt buộc)"><InputText @bind-Value="Model.Email" maxlength="255" inputmode="email" /></FormField>
        </div>
        @if (IsEditing)
        {
            <p class="customer-help">Mã nhân viên được giữ nguyên khi chỉnh sửa. Hồ sơ nhân viên không thay thế tài khoản đăng nhập.</p>
        }
        <div class="customer-actions">
            <button type="submit" class="primary">Lưu nhân viên</button>
            <button type="button" class="secondary" @onclick="OnCancel">Hủy</button>
        </div>
    </ValidatedForm>
</div>

@code {
    [Parameter, EditorRequired] public EmployeeDraft Model { get; set; } = default!;
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
