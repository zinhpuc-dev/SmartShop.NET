<div class="customer-selector">
    <TruongNhapLieu Label="Nhà cung cấp đã chọn">
        <input readonly value="@Display" aria-label="Nhà cung cấp đã chọn" />
    </TruongNhapLieu>
    <button type="button" class="secondary" aria-label="Tìm và chọn nhà cung cấp" @onclick="() => open = true">… Chọn nhà cung cấp</button>
</div>
@if (open)
{
    <TimChonNhaCungCap OnSelected="Chon" OnClose="() => open = false" />
}

@code {
    [Parameter] public NhaCungCapDTO? Value { get; set; }
    [Parameter] public EventCallback<NhaCungCapDTO?> ValueChanged { get; set; }
    private bool open;
    private string Display => Value is null ? "Chưa chọn nhà cung cấp" : $"{Value.Code} — {Value.Name} — {Value.Phone}";
    private Task Chon(NhaCungCapDTO supplier) => ValueChanged.InvokeAsync(supplier);
}
