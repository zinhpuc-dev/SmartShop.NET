<dl class="customer-profile">
    <dt>Mã khách hàng</dt><dd>@Value.Code</dd>
    <dt>Họ và tên</dt><dd>@Value.Name</dd>
    <dt>Số điện thoại</dt><dd>@Value.Phone</dd>
    <dt>Email</dt><dd>@(string.IsNullOrEmpty(Value.Email) ? "Chưa cung cấp" : Value.Email)</dd>
    <dt>Địa chỉ</dt><dd>@Value.Address</dd>
</dl>

@code {
    [Parameter, EditorRequired] public Customer Value { get; set; } = default!;
}
