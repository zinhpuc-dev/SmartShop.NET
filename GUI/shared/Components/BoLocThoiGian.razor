@using SmartShop.BUS

<div class="time-filter">
    <fieldset disabled="@Disabled">
        <legend>Chọn thời gian thống kê</legend>
        <div class="fields">
            <label>Theo kỳ
                <select @bind="ky">
                    <option value="@KyThongKe.KhoangNgay">Khoảng ngày</option>
                    <option value="@KyThongKe.Thang">Tháng</option>
                    <option value="@KyThongKe.Quy">Quý</option>
                    <option value="@KyThongKe.Nam">Năm</option>
                </select>
            </label>
            @if (ky == KyThongKe.KhoangNgay)
            {
                <label>Từ ngày<input type="date" min="1000-01-01" max="9998-12-31" @bind="tuNgay" /></label>
                <label>Đến ngày<input type="date" min="1000-01-01" max="9998-12-31" @bind="denNgay" /></label>
            }
            else
            {
                <label>Năm<input type="number" min="1000" max="9998" step="1" @bind="nam" /></label>
                @if (ky == KyThongKe.Thang)
                {
                    <label>Tháng<select @bind="thang">@for (var i = 1; i <= 12; i++) { <option value="@i">Tháng @i</option> }</select></label>
                }
                @if (ky == KyThongKe.Quy)
                {
                    <label>Quý<select @bind="quy">@for (var i = 1; i <= 4; i++) { <option value="@i">Quý @i</option> }</select></label>
                }
            }
            <button type="button" class="primary" @onclick="ApDung">Xem báo cáo</button>
        </div>
    </fieldset>
    <p class="help">Báo cáo tính trọn ngày kết thúc. Bấm Xem báo cáo để áp dụng lựa chọn.</p>
    @if (!string.IsNullOrEmpty(loi)) { <p class="error" role="alert">@loi</p> }
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public BoLocThoiGianThongKe Value { get; set; } = new();
    [Parameter] public EventCallback<BoLocThoiGianThongKe> OnApplied { get; set; }
    private BoLocThoiGianThongKe? giaTriDaNhan;
    private KyThongKe ky = KyThongKe.KhoangNgay;
    private DateTime? tuNgay = DateTime.Today.AddDays(-29), denNgay = DateTime.Today;
    private int? nam = DateTime.Today.Year;
    private int thang = DateTime.Today.Month, quy = (DateTime.Today.Month - 1) / 3 + 1;
    private string loi = "";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(giaTriDaNhan, Value)) return;
        giaTriDaNhan = Value;
        ky = Value.Ky; tuNgay = Value.TuNgay; denNgay = Value.DenNgay;
        nam = Value.Nam; thang = Value.Thang; quy = Value.Quy;
        loi = "";
    }

    private async Task ApDung()
    {
        if (Disabled) return;
        BoLocThoiGianThongKe boLoc;
        try
        {
            if (ky == KyThongKe.KhoangNgay && (tuNgay is null || denNgay is null))
                throw new ArgumentException("Vui lòng nhập đủ ngày bắt đầu và ngày kết thúc.");
            if (ky != KyThongKe.KhoangNgay && nam is null)
                throw new ArgumentException("Vui lòng nhập năm thống kê.");
            boLoc = new BoLocThoiGianThongKe
            {
                Ky = ky, TuNgay = tuNgay ?? default, DenNgay = denNgay ?? default,
                Nam = nam ?? 0, Thang = thang, Quy = quy
            };
            _ = XuLyKyThongKe.ChuyenThanhKhoang(boLoc);
        }
        catch (ArgumentException ex) { loi = ex.Message; return; }
        loi = "";
        await OnApplied.InvokeAsync(boLoc);
    }
}
