<details class="advanced-search">
    <summary>Tìm kiếm nâng cao @if (AppliedGroups > 0) { <span>· @AppliedGroups nhóm đang áp dụng</span> }</summary>
    <p>Các điều kiện trong một nhóm phải đồng thời đúng (AND). Chỉ cần một nhóm đúng (OR). Chọn NOT để đảo kết quả của một điều kiện.</p>
    @foreach (var group in groups)
    {
        var groupIndex = groups.IndexOf(group) + 1;
        <fieldset @key="group">
            <legend>Nhóm @groupIndex @(groupIndex > 1 ? "— OR (hoặc)" : "")</legend>
            @foreach (var condition in group)
            {
                var position = $"{groupIndex}.{group.IndexOf(condition) + 1}";
                <div class="condition" @key="condition">
                    <label class="negation"><input type="checkbox" @bind="condition.Negate" aria-label="NOT điều kiện @position" /> NOT</label>
                    <label>Trường
                        <select value="@condition.Field" @onchange="args => ChangeField(condition, args.Value?.ToString())" aria-label="Trường điều kiện @position">
                            @foreach (var field in Fields) { <option value="@field.Key">@field.Label</option> }
                        </select>
                    </label>
                    <label>So sánh
                        <select @bind="condition.Operator" aria-label="So sánh điều kiện @position">
                            @foreach (var operation in Operations(condition)) { <option value="@operation">@OperatorLabel(operation)</option> }
                        </select>
                    </label>
                    <label>Giá trị
                        <input @bind="condition.Value" maxlength="500" inputmode="@(IsNumber(condition) ? "decimal" : "text")" aria-label="Giá trị điều kiện @position" />
                    </label>
                    <button type="button" class="secondary" aria-label="Xóa điều kiện @position" disabled="@(group.Count == 1)" @onclick="() => group.Remove(condition)">Xóa</button>
                </div>
            }
            <div class="group-actions">
                <button type="button" class="text-button" disabled="@(group.Count >= 8)" @onclick="() => group.Add(NewCondition())">+ Điều kiện AND</button>
                <button type="button" class="text-button" disabled="@(groups.Count == 1)" @onclick="() => groups.Remove(group)">Xóa nhóm @groupIndex</button>
            </div>
        </fieldset>
    }
    <p class="number-hint">Số thập phân dùng dấu phẩy hoặc dấu chấm, không nhập dấu phân cách hàng nghìn. Để trống giá trị khi tìm trường văn bản rỗng.</p>
    @if (!string.IsNullOrEmpty(Error)) { <p class="filter-error" role="alert">@Error</p> }
    <div class="filter-actions">
        <button type="button" class="secondary" disabled="@(groups.Count >= 8)" @onclick="AddGroup">+ Nhóm OR</button>
        <button type="button" class="primary" @onclick="Apply">Áp dụng bộ lọc</button>
        <button type="button" class="text-button" @onclick="Clear">Bỏ bộ lọc nâng cao</button>
    </div>
</details>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SearchField> Fields { get; set; } = [];
    [Parameter] public EventCallback<CatalogFilter?> OnApply { get; set; }
    [Parameter] public string Error { get; set; } = "";
    private readonly List<List<ConditionDraft>> groups = [];
    [Parameter] public CatalogFilter? AppliedFilter { get; set; }
    private int AppliedGroups => AppliedFilter?.Groups.Count ?? 0;

    protected override void OnInitialized()
    {
        if (AppliedFilter is null || AppliedFilter.Groups.Count == 0) { AddGroup(); return; }
        foreach (var group in AppliedFilter.Groups)
            groups.Add(group.Conditions.Select(condition => new ConditionDraft
            {
                Field = condition.Field, Operator = condition.Operator,
                Value = condition.Value, Negate = condition.Negate
            }).ToList());
    }

    private ConditionDraft NewCondition() => new() { Field = Fields[0].Key,
        Operator = Fields[0].Type == SearchFieldType.Number ? SearchOperator.Equal : SearchOperator.Contains };

    private void AddGroup() => groups.Add([NewCondition()]);

    private bool IsNumber(ConditionDraft condition) => Fields.Single(field => field.Key == condition.Field).Type == SearchFieldType.Number;

    private void ChangeField(ConditionDraft condition, string? key)
    {
        condition.Field = key ?? Fields[0].Key;
        condition.Operator = IsNumber(condition) ? SearchOperator.Equal : SearchOperator.Contains;
    }

    private IEnumerable<SearchOperator> Operations(ConditionDraft condition) => IsNumber(condition)
        ? [SearchOperator.Equal, SearchOperator.NotEqual, SearchOperator.GreaterThan,
            SearchOperator.GreaterOrEqual, SearchOperator.LessThan, SearchOperator.LessOrEqual]
        : [SearchOperator.Contains, SearchOperator.Equal, SearchOperator.NotEqual];

    private static string OperatorLabel(SearchOperator operation) => operation switch
    {
        SearchOperator.Contains => "Chứa",
        SearchOperator.Equal => "=",
        SearchOperator.NotEqual => "<>",
        SearchOperator.GreaterThan => ">",
        SearchOperator.GreaterOrEqual => ">=",
        SearchOperator.LessThan => "<",
        SearchOperator.LessOrEqual => "<=",
        _ => ""
    };

    private async Task Apply()
    {
        var filter = new CatalogFilter(groups.Select(group => new SearchGroup(group.Select(condition =>
            new SearchCondition(condition.Field, condition.Operator, condition.Value, condition.Negate)).ToArray())).ToArray());
        await OnApply.InvokeAsync(filter);
    }

    private async Task Clear()
    {
        await OnApply.InvokeAsync(null);
        groups.Clear();
        AddGroup();
    }

    private sealed class ConditionDraft
    {
        public string Field { get; set; } = "";
        public SearchOperator Operator { get; set; }
        public string Value { get; set; } = "";
        public bool Negate { get; set; }
    }
}
