@inherits TrangCoSo
@if(selected is not null){var p=selected;<HopThoai Label="Chi tiết sản phẩm" CssClass="product-modal" OnClose="() => selected = null"><div class="detail-art"><MinhHoaThietBi Color="@p.Color" Category="@p.Category"/></div><div><div class="eyebrow red">CHÍNH HÃNG · BẢO HÀNH 12 THÁNG</div><h1>@p.Name</h1><p>@p.Spec</p><div class="rating">★★★★★ <span>Được khách hàng yêu thích</span></div><h2 class="red">@DinhDangTienTe.DinhDang(p.Price)</h2><del>@DinhDangTienTe.DinhDang(p.Original)</del><p>Hiệu năng mạnh mẽ, thiết kế tinh tế. Sẵn sàng cho công việc và những trải nghiệm mỗi ngày.</p><div class="payment">◇ Chính hãng · ↻ Đổi trả 7 ngày</div><p class="muted">Còn @p.Stock sản phẩm · Hình minh họa</p><button class="primary wide" @onclick="()=>ThemVaoGio(p)">Thêm vào giỏ hàng +</button><button class="secondary wide" @onclick='()=>{if(ThemVaoGio(p)){selected=null;DieuHuong("cart");}}'>Mua ngay</button></div></HopThoai>}
@if(editing is not null){<HopThoai Label="Thông tin sản phẩm" CssClass="narrow" OnClose="() => editing = null"><h2>@editing.Name</h2><p class="muted">Thông tin sản phẩm do cửa hàng quản lý.</p><button class="secondary" @onclick="() => editing = null">Đóng</button></HopThoai>}
@if(toast!=""){<div class="toast" role="status">✓ @toast <button aria-label="Đóng thông báo" @onclick='()=>toast=""'>×</button></div>}

